  "narration": [
    {
      "from": 0,
      "to": 3.5,
      "heading": "Under the ice",
      "text": "Under your feet: four kilometres of ice. And under that, a hidden lake."
    },
    {
      "from": 3.5,
      "to": 9.5,
      "heading": "Vostok Station",
      "text": "This is Vostok Station, Antarctica. In 1983 it hit minus eighty-nine point two degrees, the coldest ever measured on Earth.",
      "source": "Vostok Station, Wikipedia",
      "beats": [
        {
          "word": "coldest",
          "kind": "stamp",
          "value": "COLDEST ON EARTH"
        }
      ]
    },
    {
      "from": 9.5,
      "to": 15.5,
      "heading": "Going down",
      "text": "The ice here is so thick, its surface sits three and a half kilometres above sea level.",
      "source": "Vostok Station, Wikipedia",
      "beats": [
        {
          "word": "thick",
          "kind": "stat",
          "value": "3,488 m",
          "label": "above sea level"
        }
      ]
    },
    {
      "from": 15.5,
      "to": 21.5,
      "heading": "3,310 m down",
      "text": "Three thousand three hundred and ten metres down, this ice fell as snow four hundred and fourteen thousand years ago.",
      "source": "Vostok Station, Wikipedia",
      "beats": [
        {
          "word": "snow",
          "kind": "stat",
          "value": "414,000 yrs",
          "label": "old ice"
        }
      ]
    },
    {
      "from": 21.5,
      "to": 27.5,
      "heading": "Frozen history",
      "text": "That one ice core is a record of Earth's climate stretching back through four ice ages.",
      "source": "Vostok Station, Wikipedia",
      "beats": [
        {
          "word": "four",
          "kind": "stat",
          "value": "4",
          "label": "ice ages on record"
        }
      ]
    },
    {
      "from": 27.5,
      "to": 34,
      "heading": "Breakthrough",
      "text": "Three thousand seven hundred and sixty-eight metres. In February 2012, Russian drillers finally broke through.",
      "source": "Lake Vostok, Wikipedia",
      "beats": [
        {
          "word": "broke",
          "kind": "stamp",
          "value": "BREAKTHROUGH"
        },
