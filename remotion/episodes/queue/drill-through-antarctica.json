    },
    {
      "from": 34,
      "to": 40.5,
      "heading": "Lake Vostok",
      "text": "Below is Lake Vostok: two hundred and fifty kilometres long, and sealed off for perhaps fifteen million years.",
      "source": "Lake Vostok, Wikipedia",
      "beats": [
        {
          "word": "sealed",
          "kind": "stat",
