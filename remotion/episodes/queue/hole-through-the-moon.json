  "narration": [
    {
      "from": 0,
      "to": 3.5,
      "heading": "The hole",
      "text": "Someone drilled a hole straight through the Moon. And you just stepped in."
    },
    {
      "from": 3.5,
      "to": 9.5,
      "heading": "4 m down",
      "text": "Four metres down, the Moon dust ends. That's the average under its dark lava plains.",
      "source": "Brown University, 2026",
      "beats": [
        {
          "word": "dust",
          "kind": "compare",
          "compare": {
            "name": "You",
            "value": 1.7,
            "icon": "person",
            "subject": "Moon dust",
            "subjectValue": 4,
            "unit": "m",
            "note": "Twice your height"
          }
        }
      ]
    },
    {
      "from": 9.5,
      "to": 15.5,
      "heading": "8 km down",
      "text": "Eight kilometres. As deep as the Moon's biggest crater, a scar two thousand five hundred kilometres wide.",
      "source": "South Pole–Aitken basin, Wikipedia",
      "beats": [
        {
          "word": "crater",
          "kind": "compare",
          "compare": {
            "name": "Mount Everest",
            "value": 8.8,
            "icon": "mountain",
            "subject": "Biggest crater",
            "subjectValue": 8.2,
            "unit": "km",
            "note": "Nearly an Everest deep"
          }
        },
        {
          "word": "thousand",
          "kind": "stat",
          "value": "2,500 km",
          "label": "crater width"
        }
      ]
    },
    {
      "from": 15.5,
      "to": 21.5,
      "heading": "The crust ends",
      "text": "Forty kilometres: the crust ends. On the far side, it can be sixty kilometres thick.",
      "source": "NASA Moon facts",
      "beats": [
        {
          "word": "sixty",
          "kind": "stat",
          "value": "60 km",
          "label": "far-side crust"
        }
      ]
    },
    {
      "from": 21.5,
      "to": 27.5,
      "heading": "1,000 km down",
      "text": "A thousand kilometres down, the rock is shaking. This is where deep moonquakes start.",
      "source": "Internal structure of the Moon, Wikipedia",
      "beats": [
        {
          "word": "moonquakes",
          "kind": "stamp",
          "value": "MOONQUAKES"
        }
      ]
    },
    {
      "from": 27.5,
      "to": 34,
      "heading": "The core",
      "text": "Then the rock turns partly molten. Then liquid iron. Then a solid iron ball, with a radius of two hundred and forty kilometres.",
      "source": "NASA Moon facts",
      "beats": [
        {
          "word": "liquid",
          "kind": "warning",
          "value": "LIQUID IRON"
        },
        {
          "word": "radius",
          "kind": "stat",
          "value": "240 km",
          "label": "solid iron core"
        }
      ]
    },
    {
      "from": 34,
      "to": 40.5,
      "heading": "The centre",
      "text": "The centre: about fourteen hundred degrees. Hot, but Earth's core is as hot as the Sun's surface.",
      "source": "Internal structure of the Moon, Wikipedia",
      "beats": [
        {
          "word": "Earth's",
          "kind": "compare",
          "compare": {
            "name": "Earth's centre",
            "value": 6000,
            "icon": "land",
            "subject": "Moon's centre",
            "subjectValue": 1400,
            "unit": "°C",
            "note": "Earth's is 4× hotter"
          }
        }
      ]
    },
    {
      "from": 40.5,
      "to": 47,
      "heading": "The twist",
      "text": "The twist? The Moon is tiny, but the fall takes longer. About fifty-five minutes, against thirty-eight for Earth.",
      "source": "Cramer, Analog AV-32",
      "beats": [
        {
          "word": "longer",
          "kind": "stamp",
          "value": "IT TAKES LONGER"
        },
        {
          "word": "fifty-five",
          "kind": "compare",
          "compare": {
            "name": "Earth fall",
            "value": 38,
            "icon": "land",
            "subject": "Moon fall",
            "subjectValue": 55,
            "unit": "min",
            "note": "Smaller, yet slower"
          }
        }
      ]
    },
    {
      "from": 47,
      "to": 54,
      "heading": "Why so slow?",
      "text": "Why? The Moon is far less dense, so its pull is weak, a sixth of Earth's. Which would you jump through?",
      "source": "Moon, Wikipedia",
      "beats": [
        {
          "word": "sixth",
          "kind": "stat",
          "value": "1/6",
          "label": "of Earth's gravity"
        }
      ]
