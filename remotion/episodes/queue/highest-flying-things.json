  "narration": [
    {
      "from": 0,
      "to": 3.5,
      "heading": "Lift-off",
      "text": "You're chasing the highest thing that can fly. First stop? A goose."
    },
    {
      "from": 3.5,
      "to": 9.5,
      "heading": "7.3 km up",
      "text": "Bar-headed geese fly over the Himalayas. One was tracked at seven thousand two hundred and ninety metres.",
      "source": "Bar-headed goose, Wikipedia",
      "beats": [
        {
          "word": "tracked",
          "kind": "stat",
          "value": "7,290 m",
          "label": "highest tracked goose"
        }
      ]
    },
    {
      "from": 9.5,
      "to": 16,
      "heading": "11.3 km up",
      "text": "In 1973, a Rüppell's vulture hit an airliner up here, over Ivory Coast. It's the highest bird ever confirmed.",
      "source": "Rüppell's vulture, Wikipedia",
      "beats": [
        {
          "word": "airliner",
          "kind": "compare",
          "compare": {
            "name": "Mount Everest",
            "value": 8.8,
            "icon": "mountain",
            "subject": "Vulture strike",
            "subjectValue": 11.3,
            "unit": "km",
            "note": "A bird above Everest"
          }
        },
        {
          "word": "highest",
          "kind": "stamp",
          "value": "HIGHEST BIRD"
        }
      ]
    },
    {
      "from": 16,
      "to": 23,
      "heading": "25.9 km up",
      "text": "In 1976, an SR-71 Blackbird set the level-flight record up here. It could top three thousand kilometres an hour.",
      "source": "Lockheed SR-71 Blackbird, Wikipedia",
      "beats": [
        {
          "word": "record",
          "kind": "compare",
          "compare": {
            "name": "Mount Everest",
            "value": 8.8,
            "icon": "mountain",
            "subject": "SR-71 record",
            "subjectValue": 25.9,
            "unit": "km",
            "note": "Three Everests up"
          }
        },
        {
          "word": "three",
          "kind": "stat",
          "value": "3,529 km/h",
          "label": "SR-71 speed record"
        }
      ]
    },
    {
      "from": 23,
      "to": 30,
      "heading": "53.7 km up",
      "text": "Wings give up long before this. But in 2013, a Japanese research balloon floated all the way up here. A record.",
      "source": "High-altitude balloon, Wikipedia",
      "beats": [
        {
          "word": "balloon",
          "kind": "compare",
          "compare": {
            "name": "SR-71 record",
            "value": 25.9,
            "icon": "plane",
            "subject": "Record balloon",
            "subjectValue": 53.7,
            "unit": "km",
            "note": "Twice the Blackbird"
          }
        },
        {
          "word": "record",
          "kind": "stamp",
          "value": "WORLD RECORD"
        }
      ]
    },
    {
      "from": 30,
      "to": 36,
      "heading": "About 100 km up",
      "text": "Around a hundred kilometres up, shooting stars flare and vanish. Most are no bigger than a grain of sand.",
      "source": "Meteor, Wikipedia",
      "beats": [
        {
          "word": "sand",
          "kind": "warning",
          "value": "GRAIN OF SAND"
        }
      ]
    },
    {
      "from": 36,
      "to": 43,
      "heading": "The twist",
      "text": "Here's the twist. Above this, nothing really flies. Things up here are falling, moving sideways so fast they keep missing Earth.",
      "source": "NASA: What Is an Orbit?",
      "beats": [
        {
          "word": "falling",
          "kind": "stamp",
          "value": "IT'S FALLING"
        }
      ]
    },
    {
      "from": 43,
      "to": 50,
      "heading": "Hubble · ~475 km",
      "text": "Like Hubble. Almost five hundred kilometres up, it's been falling around us since 1990, once every ninety-five minutes.",
      "source": "NASA Hubble by the Numbers",
      "beats": [
        {
          "word": "falling",
          "kind": "stat",
          "value": "27,000 km/h",
          "label": "Hubble's sideways speed"
        }
      ]
    },
    {
      "from": 50,
      "to": 57.5,
      "heading": "Zoom out",
      "text": "Wings got you to twenty-six kilometres. A balloon, to fifty-three. Beyond that, you don't fly. You fall. What would you send up next?",
      "source": "Lockheed SR-71 Blackbird; High-altitude balloon"
    }
  ],
