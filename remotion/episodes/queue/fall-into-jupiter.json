          "value": "NO SURFACE"
        }
      ]
    },
    {
      "from": 9.5,
      "to": 15,
      "heading": "Ammonia clouds",
      "text": "First, the top clouds: frozen ammonia, at a bit under the air pressure on Earth.",
      "source": "Atmosphere of Jupiter, Wikipedia",
      "beats": [
        {
          "word": "ammonia",
          "kind": "warning",
          "value": "AMMONIA ICE"
        }
      ]
    },
    {
      "from": 15,
      "to": 21,
      "heading": "Deeper clouds",
      "text": "Below them, clouds of ammonium hydrosulfide. Then, deeper still, clouds of water.",
      "source": "Atmosphere of Jupiter, Wikipedia",
      "beats": [
        {
          "word": "water",
          "kind": "stat",
          "value": "3–7 bar",
          "label": "water clouds"
        }
      ]
    },
    {
      "from": 21,
      "to": 27,
      "heading": "Galileo",
      "text": "In 1995, the Galileo probe fell in here. It went silent a hundred and thirty-two kilometres down.",
      "source": "Atmosphere of Jupiter, Wikipedia",
      "beats": [
        {
          "word": "silent",
          "kind": "stamp",
          "value": "SIGNAL LOST"
        }
      ]
    },
    {
      "from": 27,
      "to": 33,
      "heading": "Crushed",
      "text": "Deeper inside, the pressure and heat crush, melt and vaporise any spacecraft that tries.",
      "source": "NASA Jupiter facts",
      "beats": [
        {
          "word": "crush",
          "kind": "warning",
          "value": "CRUSHED + MELTED"
        }
      ]
    },
    {
      "from": 33,
      "to": 39,
      "heading": "Liquid metal",
      "text": "More than ten thousand kilometres down, hydrogen turns into a liquid that conducts electricity, like metal.",
      "source": "Atmosphere of Jupiter, Wikipedia",
      "beats": [
        {
          "word": "metal",
          "kind": "stamp",
          "value": "LIQUID METAL"
        }
      ]
    },
    {
      "from": 39,
      "to": 45.5,
