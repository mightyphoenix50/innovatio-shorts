# Copy to .env and fill in. Never commit .env or paste it into docs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Music style: lobby (default) or ambient
SOUND_STYLE=lobby
# Optional: raises the Openverse rate limit (https://api.openverse.org/v1/#tag/auth)
OPENVERSE_TOKEN=
# Free key: https://freesound.org/apiv2/apply
FREESOUND_API_KEY=
